# ============================================================
# ไฟล์ตั้งค่าตัวเดียวของทั้งระบบ (backend + frontend อ่านไฟล์นี้ไฟล์เดียว)
# ไม่มีไฟล์ .env ก็รันได้ (ถ้าเตรียมฐานข้อมูลตาม database/README.md แล้ว) — สร้างเมื่อต้องการเปลี่ยนค่า:  npm run setup
# ============================================================

# ---- ชื่อและหน้าตา ----
APP_NAME=ระบบภายใน
APP_THEME=herb            # herb (เขียว-ครีม) | ocean | rose | slate | care (เขียวน้ำเงิน) | indigo | amber | graphite — เพิ่มชุดสีเองที่ frontend/src/theme.css

# ---- พอร์ต ----
PORT=4000                 # พอร์ตของ API (หน้าเว็บ proxy ไปหาพอร์ตนี้เอง)
WEB_PORT=5173             # พอร์ตของหน้าเว็บตอนพัฒนา

# ---- ฐานข้อมูล: mariadb (ค่าเริ่มต้น) | mysql | postgres ----
# ต้องเตรียมฐานข้อมูลก่อน — ดู database/README.md (ค่าด้านล่างตรงกับ database/init.sql)
# ตารางไม่ต้องสร้างเอง ระบบสร้างให้ตอนรัน
DB_CLIENT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306              # postgres = 5432
DB_NAME=app_core
DB_USER=app
DB_PASSWORD=app_password  # สำคัญ: production ต้องเปลี่ยน (ระบบไม่ยอมเริ่มถ้ายังเป็นค่านี้)

# ---- ความปลอดภัย ----
# JWT_SECRET=             # npm run setup จะสุ่มให้ — production ต้องตั้ง (ยาว 32 ตัวอักษรขึ้นไป)
# JWT_HOURS=12
# COOKIE_SECURE=true      # เปิดเมื่อใช้ HTTPS

# ---- กุญแจเข้ารหัสข้อมูลส่วนบุคคลที่เก็บในฐานข้อมูลของโปรเจกต์ (core/crypto.ts) — ใช้เมื่อโปรเจกต์ต้องเก็บข้อมูลผู้ป่วยเอง ----
# DATA_ENC_KEY=           # เข้ารหัส/ถอดรหัส (npm run setup สุ่มให้) — เปลี่ยนแล้วข้อมูลเดิมถอดไม่ได้ ต้องสำรองไว้
# HASH_KEY=               # รหัสแทนสำหรับค้นหา (blind index) แยกจากกุญแจด้านบน — เปลี่ยนแล้วค้นข้อมูลเดิมไม่เจอ

# ---- ผู้ดูแลระบบคนแรก (สร้างให้ตอนฐานข้อมูลยังไม่มีผู้ใช้) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!123

# ---- อื่น ๆ ----
# AUTO_MIGRATE=true       # สร้าง/อัปเดตตารางตอนเปิดระบบ (ค่าเริ่มต้น: เปิดตอนพัฒนา ปิดตอน production → สั่ง npm run migrate เอง)

# ---- ตัวเชื่อมต่อ LLM (ไม่ใส่ = ปิด) — ดู backend/src/integrations/README.md ----
# LLM_BASE_URL=http://127.0.0.1:11434   # Ollama = 11434, LM Studio = 1234
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT_SEC=120
# LLM_MODE=real                         # real | fake (ไม่ยิงจริง ใช้ตอนพัฒนา) | off

# ---- ตัวเชื่อมต่อ Backend Core (ตัวกลางข้อมูลโรงพยาบาล; ไม่ใส่ CORE_URL = ปิด) — ดู docs/06-ต่อกับ-backend-core.md ----
# CORE_URL=https://core.hospital.local
# CORE_CLIENT_ID=
# CORE_CLIENT_SECRET=                   # ค่าลับ: อยู่ใน .env เท่านั้น ห้ามส่งไปเบราว์เซอร์
# CORE_TIMEOUT_SEC=15
# CORE_MODE=real                        # real | fake (ไม่ยิงจริง) | off

# ---- แหล่งข้อมูลเพิ่มเติมแบบ "อ่านอย่างเดียว" (เช่น HOSxP) — ตั้งชื่อเองได้ ใส่คำนำหน้า <ชื่อ>_DB_ ----
# ใช้ในโค้ด: readonlyDb('hosxp')('patient').select(...)  (ดู backend/src/core/datasource.ts)
# HOSXP_DB_CLIENT=mariadb               # mariadb | mysql | postgres
# HOSXP_DB_HOST=
# HOSXP_DB_PORT=3306
# HOSXP_DB_NAME=
# HOSXP_DB_USER=                        # ขอ user ที่มีสิทธิ์ SELECT อย่างเดียว
# HOSXP_DB_PASSWORD=
# HOSXP_DB_QUERY_TIMEOUT_SEC=30
